# Copy to .env.local for local dev. Set the same names in the Vercel project.
# Never commit .env.local — it is gitignored.

# --- AI (xAI Grok) ----------------------------------------------------------
# Required for every AI feature: LOI / listing-agreement form fill, Flow deal
# extraction (LOI, PSA, escrow), marketing send-time and week rebalance,
# listing email drafts, and market-intel briefs.
# Create a key at https://console.x.ai/ and paste it here.
XAI_API_KEY=

# Optional. Only used if a feature opts back into Claude
# (provider: "anthropic" on completeText in src/lib/ai/client.ts).
# The app does not call Anthropic unless that is set.
# ANTHROPIC_API_KEY=

# Not used. Drafts and intel briefs now go through XAI_API_KEY.
# OPENAI_API_KEY=

# --- Staff assistant ---------------------------------------------------------
# All optional: the defaults below apply when these are unset. Same names go in
# the Vercel project. See docs/assistant.md.
# ASSISTANT_FAST_MODEL=grok-4.3
# ASSISTANT_SUMMARY_MODEL=grok-4.3
# ASSISTANT_FAST_REASONING=none
# ASSISTANT_SUMMARY_REASONING=medium
# Monthly spend cap in dollars. Resets at midnight on the 1st, Arizona time.
# ASSISTANT_MONTHLY_BUDGET_USD=50
# Extra owners (see every deal), comma-separated. Kevin is always an owner.
# ASSISTANT_OWNER_EMAILS=
# The assistant reads the database as a read-only role through a short-lived
# signed token. Both are required, from Supabase Project Settings:
#   SUPABASE_JWT_SECRET  Project Settings > JWT Keys > Legacy JWT Secret
#   SUPABASE_ANON_KEY    the public (anon / publishable) key
# SUPABASE_JWT_SECRET=
# SUPABASE_ANON_KEY=

# --- Already used by the rest of the app ------------------------------------
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
# RESEND_SEGMENT_ID_ALL=
# RESEND_SEGMENT_ID_TEST=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ACCESS_TOKEN=
# CRON_SECRET=
# CRE8_WORKER_KEY=
# NEXT_PUBLIC_MAPBOX_TOKEN=
# NEXT_PUBLIC_MSAL_CLIENT_ID=
# NEXT_PUBLIC_MSAL_TENANT_ID=
